Options -Indexes

# Block direct access to sensitive files
<FilesMatch "^(config\.php|config\.sample\.php|install\.sql|README\.md|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
